# VoiceStudio Backend Configuration
# Copy to backend/.env and modify

# Server
HOST=127.0.0.1
PORT=3900
DEBUG=false

# App
APP_NAME=VoiceStudio
APP_VERSION=0.1.0

# Compute
DEVICE=auto
FP16=true
GPU_WORKERS=1

# Models
DEFAULT_TTS_ENGINE=omnivoice
DEFAULT_ASR_ENGINE=whisperx
DEFAULT_DIARIZATION_ENGINE=pyannote

# Timeouts
GENERATE_TIMEOUT_S=300
CPU_GENERATE_TIMEOUT_S=600

# Paths
DATA_DIR=./data
MODELS_DIR=./models
AUDIO_OUTPUT_DIR=./outputs/audio
CACHE_DIR=./cache

# Auth (for remote admin UI)
REMOTE_API_KEY=

# External services
HF_TOKEN=
HF_TOKEN_ENV=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=http://localhost:3902,app://voicestudio
