{
  "name": "@speech-synthesis/electron",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "electron-vite build && bun run build:web",
    "build:web": "vite build --config vite.config.web.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/store": "^0.5.0",
    "@tanstack/virtual": "^3.0.0",
    "i18next": "^24.0.0",
    "react-i18next": "^15.0.0",
    "sonner": "^2.0.0",
    "lucide-react": "^0.400.0",
    "wavesurfer.js": "^7.0.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0",
    "zustand": "^5.0.0",
    "axios": "^1.7.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-vite": "^6.0.0",
    "electron-builder": "^25.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^8.0.0",
    "typescript": "^6.0.0",
    "tsgo": "^1.0.0",
    "vitest": "^3.0.0",
    "oxlint": "^0.15.0",
    "oxfmt": "^0.15.0",
    "tailwindcss": "^4.0.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0"
  }
}