{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install All Dependencies",
      "type": "shell",
      "command": "bun install && bun run setup:api",
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Start Development (Full)",
      "type": "shell",
      "command": "bun run dev",
      "group": "test",
      "isBackground": true,
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Start Development (Web Only)",
      "type": "shell",
      "command": "bun run dev:web",
      "group": "test",
      "isBackground": true,
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Build Electron App",
      "type": "shell",
      "command": "bun run build",
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "bun run typecheck",
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "bun run lint",
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "bun run format",
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}