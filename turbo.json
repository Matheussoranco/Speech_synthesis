{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "release/**"
      ]
    },
    "build:web": {
      "outputs": [
        "dist/web/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:api": {
      "cache": false,
      "persistent": true
    },
    "dev:frontend": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "dependsOn": []
    },
    "dist": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "release/**"
      ]
    }
  },
  "globalEnv": [
    "VOICESTUDIO_SKIP_BACKEND",
    "OMNIVOICE_PORT",
    "OMNIVOICE_STARTUP_BUDGET_S"
  ]
}